# Copy to `.env.local` and fill in.

# --- Firebase web app (Firebase console > Project settings > Your apps > Web app) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# --- Firebase Admin (server only; never expose) ---
# Either paste the whole service-account JSON on one line...
FIREBASE_SERVICE_ACCOUNT_KEY=
# ...or set these three. Not needed on Firebase App Hosting.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Public app URL used for metadata, links and password-setup emails.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Resend (transactional email). https://resend.com
RESEND_API_KEY=
# Verified sender, e.g. Neon <notifications@yourdomain.com>
RESEND_FROM=

# Protects /api/cron/notifications. Call it daily with `Authorization: Bearer <CRON_SECRET>`
# (Vercel Cron, or Cloud Scheduler on Firebase App Hosting).
CRON_SECRET=

# DPOPay (only when live payments are switched on).
DPOPAY_COMPANY_TOKEN=
DPOPAY_SERVICE_TYPE=
DPOPAY_WEBHOOK_SECRET=

# Timezone used for "today" on the server (attendance, timetable, greetings). Defaults to Botswana.
APP_TIMEZONE=Africa/Gaborone
